---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Supporters"
  description="The people, institutions, and organizations who believe in what Ryzo Studios is building — and help make it possible."
>

  <!-- HERO -->
  <section class="supporters-hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <span class="eyebrow">Our Supporters</span>
      <h1 class="hero-display">
        Bound by the<br />
        <span class="accent-text">same bet.</span>
      </h1>
      <p class="hero-body">We're building alongside institutions, foundations, and individuals who hold the same conviction we do: story is the infrastructure kids use to make sense of their world — to feel it, practice it, and act on it. This generation deserves stories engineered with the craft, rigor, and measurement that moment requires. Not supporters in the sentimental sense. Co-conspirators in the work.</p>
    </div>
  </section>

  <!-- WITH GRATITUDE -->
  <section class="gratitude-section">
    <div class="gratitude-bg"></div>
    <div class="gratitude-overlay"></div>
    <div class="container gratitude-content">
      <div class="gratitude-header">
        <span class="eyebrow">With Gratitude</span>
        <h2 class="gratitude-headline">The people and organizations<br />who made this possible.</h2>
      </div>

      <div class="cards-row-main">

        <!-- Card 1: Impact Partners -->
        <div class="supporter-card accent-yellow">
          <p class="card-eyebrow">Impact Partners</p>
          <div class="logo-strip">
            <div class="logo-pill"><img src="/images/equimundo-logo.png" alt="Equimundo" class="logo-natural" /></div>
          </div>
          <p class="card-desc">Equimundo &amp; the Caring Masculinity Fund were lead partners on Rage Fighters — true collaborators in connecting story and activation inside the places where young people already live.</p>
          <a href="https://www.equimundo.org/caring-masculinity-fund/" target="_blank" rel="noopener" class="card-visit">Visit Equimundo →</a>
        </div>

        <!-- Card 2: Technology Partners -->
        <div class="supporter-card accent-purple">
          <p class="card-eyebrow">Technology Partners</p>
          <div class="logo-strip">
            <div class="logo-pill"><img src="/images/supporters/autodesk.webp" alt="Autodesk" class="logo-natural logo-xl" /></div>
            <div class="logo-pill"><img src="/images/supporters/unreal.png" alt="Unreal Engine" class="logo-natural logo-ml" /></div>
            <div class="logo-pill"><img src="/images/supporters/perforce.jpeg" alt="Perforce" class="logo-natural" /></div>
            <div class="logo-pill"><img src="/images/supporters/roblox.png" alt="Roblox" class="logo-natural logo-xl" /></div>
          </div>
          <p class="card-desc">Autodesk, Unreal, Perforce, and Roblox provide software donations and technical support that power our full pipeline — from ideation to linear media to interactive worlds.</p>
        </div>

        <!-- Card 3: Events Partners -->
        <div class="supporter-card accent-cyan">
          <p class="card-eyebrow">Events Partners</p>
          <div class="logo-strip">
            <div class="logo-pill"><img src="/images/supporters/clubhouse-network.png" alt="The Clubhouse Network" class="logo-natural" /></div>
          </div>
          <p class="card-desc">The Clubhouse Network is our live events partner, connecting kids and teens with new ways to use their creativity and take on big emotions through art, film and gaming.</p>
          <a href="https://www.clubhousenetwork.org" target="_blank" rel="noopener" class="card-visit">Visit Clubhouse Network →</a>
        </div>

      </div>

      <!-- Community row -->
      <div class="cards-row-community">

        <!-- Advisors -->
        <div class="supporter-card accent-teal">
          <p class="card-eyebrow">Advisors</p>
          <div class="logo-strip">
            <div class="logo-pill"><img src="/images/supporters/digital-wellness-lab.png" alt="Digital Wellness Lab at Boston Children's Hospital" class="logo-natural" /></div>
          </div>
          <p class="card-desc">We're grateful to the Digital Wellness Lab at Boston Children's Hospital for helping us check our impact math and improve our measurement tools.</p>
          <a href="https://digitalwellnesslab.org/" target="_blank" rel="noopener" class="card-visit">Visit the Digital Wellness Lab →</a>
        </div>

        <!-- Community Supporters -->
        <div class="supporter-card accent-subtle community-card">
          <p class="card-eyebrow">Community Supporters</p>
          <h3 class="card-title">The ones who showed up first.</h3>
          <p class="card-desc">Early believers who helped us through the studio's first stages via Kickstarter campaigns and private donations. Their conviction — before the proof points existed — made everything else possible.</p>
        </div>

        <!-- Commitments -->
        <div class="supporter-card accent-orange">
          <p class="card-eyebrow">Commitments</p>
          <div class="logo-strip">
            <div class="logo-pill"><img src="/images/supporters/inspired-internet-pledge.png" alt="Inspired Internet Pledge" class="logo-natural" /></div>
          </div>
          <p class="card-desc">Ryzo Studios is a signatory of the Inspired Internet Pledge — a public commitment to make the internet a safer, healthier place for young people, convened by the Digital Wellness Lab.</p>
          <a href="https://inspiredinternet.org/" target="_blank" rel="noopener" class="card-visit">Read the Pledge →</a>
        </div>

      </div>

    </div>
  </section>

  <!-- GET INVOLVED -->
  <section class="section get-involved-section">
    <div class="container">
      <div class="get-involved-inner">
        <div class="get-involved-text">
          <span class="eyebrow">Get Involved</span>
          <h2 class="subheadline">Ryzo is ready to scale<br /><span class="accent-text">with impact investment.</span></h2>
          <p class="body-lg">We're building an Impact Franchise Studio — multi-platform story worlds that meet young people inside gaming, animation, and digital community to engage with the big questions of their time. If you believe culture shifts through story, we'd love to talk.</p>
        </div>
        <div class="get-involved-cta">
          <a href="mailto:Erica@ryzo.studio,Todd@ryzo.studio?subject=Impact%20Investor%20Here" class="btn btn-primary btn-lg">Connect with the team →</a>
        </div>
      </div>
    </div>
  </section>

<!-- BOTTOM CTA -->
  <section class="section-sm become-section">
    <div class="container">
      <div class="become-inner">
        <div>
          <span class="eyebrow">Join Us</span>
          <h2 class="subheadline">Your name<br />on this page.</h2>
          <p class="body-lg">If you believe that young people deserve stories built for where they actually live — stories that are genuinely great and genuinely matter — we'd love to talk.</p>
        </div>
        <div class="become-cta">
          <a href="/connect" class="btn btn-primary btn-lg">Connect With Us →</a>
          <p class="become-note">All support inquiries are handled personally by the founding team.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Page backgrounds ── */
  .supporters-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 6rem 5rem;
    position: relative;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/supporters/hero-bg.png');
    background-size: cover;
    background-position: center 30%;
    transform: scaleX(-1);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8,3,22,0.82) 0%, rgba(8,3,22,0.45) 55%, rgba(8,3,22,0.12) 100%),
      linear-gradient(to top, rgba(8,3,22,0.7) 0%, transparent 50%);
  }

  .section,
  .section-sm {
    background: linear-gradient(to right, #0a0420 0%, #180730 100%);
  }

  /* ── Hero ── */
  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-content .eyebrow {
    margin-bottom: 1.25rem;
  }

  .hero-display {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--fg);
    margin-bottom: 1.5rem;
  }

  .accent-text { color: var(--accent); }

  .hero-body {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.92);
    line-height: 1.7;
    max-width: 600px;
  }

  /* ── Gratitude section ── */
  .gratitude-section {
    position: relative;
    padding-block: 5rem 5rem;
    overflow: hidden;
  }

  .gratitude-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/RageFighters_Entrance.png');
    background-size: cover;
    background-position: center 30%;
  }

  .gratitude-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 3, 22, 0.78) 0%,
      rgba(8, 3, 22, 0.72) 40%,
      rgba(8, 3, 22, 0.85) 100%
    );
  }

  .gratitude-content {
    position: relative;
    z-index: 1;
  }

  .gratitude-header {
    margin-bottom: 2.5rem;
  }

  .gratitude-header .eyebrow { margin-bottom: 0.75rem; }

  .gratitude-headline {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.1;
    margin: 0;
  }

  /* ── Cards layout ── */
  .cards-row-main {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
    align-items: stretch;
  }

  .cards-row-community {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }

  /* ── Supporter card base ── */
  .supporter-card {
    background: rgba(48, 12, 80, 0.82);
    border: 1px solid rgba(255,255,255,0.1);
    border-top: 3px solid transparent;
    border-radius: 14px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: transform 0.2s ease;
  }

  .supporter-card:hover {
    transform: translateY(-3px);
  }

  /* ── Top-border accent lines (Option B) ── */
  .accent-yellow { border-top-color: #FFE600; }
  .accent-purple { border-top-color: #a78bfa; }
  .accent-cyan   { border-top-color: #38bdf8; }
  .accent-teal   { border-top-color: #2dd4bf; }
  .accent-orange { border-top-color: #fb923c; }
  .accent-subtle { border-top-color: rgba(255,255,255,0.18); }

  /* ── Card anatomy ── */
  .card-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1.2;
    margin: 0;
  }

  /* ── Logo strip ── */
  .logo-strip {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.625rem;
    align-items: center;
    justify-content: center;
  }

  .logo-pill {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 8px;
    padding: 0.625rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 90px;
    flex-shrink: 0;
  }

  .logo-strip img {
    height: 56px;
    width: auto;
    display: block;
    object-fit: contain;
    max-width: 200px;
  }

  .logo-xl { height: 73px; max-width: 240px; }
  .logo-ml { height: 64px; max-width: 220px; }

  /* Logos with transparent backgrounds — show in natural color on dark pill */
  .logo-natural {
    opacity: 0.92;
  }


  .card-desc {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .card-visit {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    font-weight: 500;
    width: fit-content;
    margin-top: auto;
    transition: color 0.15s;
  }
  .card-visit:hover { color: rgba(255,255,255,0.85); }

  /* ── Community card background ── */
  .community-card {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 340px;
    padding: 2.5rem 3rem;
    justify-content: center;
  }

  .community-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/supporters/sticky-mural.png');
    background-size: 150%;
    background-position: center;
    opacity: 0.25;
    z-index: 0;
  }

  .community-card > * {
    position: relative;
    z-index: 1;
  }

  /* ── Get Involved ── */
  .get-involved-section {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .get-involved-inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .get-involved-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .get-involved-cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }


  /* ── Bottom CTA ── */
  .become-section {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .become-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .become-inner > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .become-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .become-note {
    font-size: var(--text-xs);
    color: var(--fg-3);
    max-width: 260px;
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .cards-row-main { grid-template-columns: 1fr 1fr; }
    .equimundo-card { grid-column: 1 / -1; }
    .cards-row-community { grid-template-columns: 1fr 1fr; }
    .community-card { grid-column: 1 / -1; order: -1; }
  }

  @media (max-width: 768px) {
    .cards-row-main { grid-template-columns: 1fr; }
    .equimundo-card { grid-column: auto; }
    .cards-row-community { grid-template-columns: 1fr; }
    .community-card { grid-column: auto; order: 0; }
    .get-involved-inner,
    .become-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .get-involved-cta { justify-content: flex-start; }
  }
</style>
