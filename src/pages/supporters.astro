---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Supporters"
  description="The people, institutions, and organizations who believe in what Ryzo Studios is building — and help make it possible."
>

  <!-- HERO -->
  <section class="supporters-hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <span class="eyebrow">Our Supporters</span>
      <h1 class="hero-display">
        Bound by the<br />
        <span class="accent-text">same bet.</span>
      </h1>
      <p class="hero-body">We're building alongside institutions, foundations, and individuals who hold the same conviction we do: story is the infrastructure kids use to make sense of their world — to feel it, practice it, and act on it. This generation deserves stories engineered with the craft, rigor, and measurement that moment requires. Not supporters in the sentimental sense. Co-conspirators in the work.</p>
    </div>
  </section>

  <!-- WITH GRATITUDE -->
  <section class="gratitude-section">
    <div class="gratitude-bg"></div>
    <div class="gratitude-overlay"></div>
    <div class="container gratitude-content">
      <div class="gratitude-header">
        <span class="eyebrow">With Gratitude</span>
        <h2 class="gratitude-headline">The people and organizations<br />who made this possible.</h2>
      </div>

      <!-- Equimundo + tech partners row -->
      <div class="cards-row-main">
        <!-- Lead Partner: Equimundo -->
        <div class="supporter-card equimundo-card">
          <div class="card-logo-wrap">
            <img src="/images/equimundo-logo.png" alt="Equimundo" class="equimundo-img" />
          </div>
          <h3 class="card-name equimundo-name">Equimundo &amp; the Caring Masculinity Fund</h3>
          <p class="card-category">Lead Partners — Rage Fighters</p>
          <p class="card-detail">The most significant contribution to the Rage Fighters game came from Equimundo and the Caring Masculinity Fund — true partners in connecting story and activation inside the places where young people already live, helping us find allies around the world.</p>
          <a href="https://www.equimundo.org/caring-masculinity-fund/" target="_blank" rel="noopener" class="card-link">Visit Equimundo →</a>
        </div>

        <!-- Technical Partners -->
        <div class="supporter-card tech-card">
          <div class="card-logo-wrap dark-logo">
            <img src="/images/supporters/autodesk.webp" alt="Autodesk" class="tech-img blend-screen" />
          </div>
          <h3 class="card-name autodesk-name">Autodesk</h3>
          <p class="card-category">Technical Partner</p>
          <p class="card-detail">Software support powering our full production pipeline.</p>
        </div>

        <div class="supporter-card tech-card">
          <div class="card-logo-wrap dark-logo">
            <img src="/images/supporters/unreal.png" alt="Unreal Engine" class="tech-img invert" />
          </div>
          <h3 class="card-name unreal-name">Unreal Engine</h3>
          <p class="card-category">Technical Partner</p>
          <p class="card-detail">The engine behind our game development.</p>
        </div>

        <div class="supporter-card tech-card">
          <div class="card-logo-wrap dark-logo">
            <img src="/images/supporters/perforce.jpeg" alt="Perforce" class="tech-img blend-screen" />
          </div>
          <h3 class="card-name perforce-name">Perforce</h3>
          <p class="card-category">Technical Partner</p>
          <p class="card-detail">Version control at production scale.</p>
        </div>
      </div>

      <!-- Community -->
      <div class="cards-row-community">
        <div class="supporter-card community-card">
          <h3 class="card-name community-name">The ones who showed up first.</h3>
          <p class="card-category">Community Supporters</p>
          <p class="card-detail">We have a robust community of supporters who helped us through the early stages of the studio via Kickstarter campaigns and private donations. Their belief — before the proof points existed — made everything else possible.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- GET INVOLVED -->
  <section class="section get-involved-section">
    <div class="container">
      <div class="get-involved-inner">
        <div class="get-involved-text">
          <span class="eyebrow">Get Involved</span>
          <h2 class="subheadline">Ryzo is ready to scale<br /><span class="accent-text">with impact investment.</span></h2>
          <p class="body-lg">We're building an Impact Franchise Studio — multi-platform story worlds that meet young people inside gaming, animation, and digital community to engage with the big questions of their time. If you believe culture shifts through story, we'd love to talk.</p>
        </div>
        <div class="get-involved-cta">
          <a href="mailto:Erica@ryzo.studio,Todd@ryzo.studio?subject=Impact%20Investor%20Here" class="btn btn-primary btn-lg">Connect with the team →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENTS PARTNERS -->
  <section class="section events-section">
    <div class="container">
      <span class="eyebrow">Events Partners</span>
      <h2 class="subheadline">Where the work shows up live.</h2>
      <div class="events-card">
        <div class="card-logo-wrap">
          <img src="/images/supporters/clubhouse-network.png" alt="The Clubhouse Network" class="clubhouse-img" />
        </div>
        <p class="card-detail">We partner extensively with the Clubhouse Network to deliver live events that connect kids and teens with new ways to use their creativity and connect around their emotions.</p>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="section-sm become-section">
    <div class="container">
      <div class="become-inner">
        <div>
          <span class="eyebrow">Join Us</span>
          <h2 class="subheadline">Your name<br />on this page.</h2>
          <p class="body-lg">If you believe that young people deserve stories built for where they actually live — stories that are genuinely great and genuinely matter — we'd love to talk.</p>
        </div>
        <div class="become-cta">
          <a href="/connect" class="btn btn-primary btn-lg">Connect With Us →</a>
          <p class="become-note">All support inquiries are handled personally by the founding team.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Page backgrounds ── */
  .supporters-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 6rem 5rem;
    position: relative;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 40% 30%, rgba(124, 92, 191, 0.15) 0%, transparent 55%),
      linear-gradient(to right, #080316, #1c0832);
  }

  .section,
  .section-sm {
    background: linear-gradient(to right, #0a0420 0%, #180730 100%);
  }

  /* ── Hero ── */
  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-content .eyebrow {
    margin-bottom: 1.25rem;
  }

  .hero-display {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.5vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--fg);
    margin-bottom: 1.5rem;
  }

  .accent-text { color: var(--accent); }

  .hero-body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.7;
    max-width: 600px;
  }

  /* ── Gratitude section ── */
  .gratitude-section {
    position: relative;
    padding-block: 5rem 5rem;
    overflow: hidden;
  }

  .gratitude-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/RageFighters_Entrance.png');
    background-size: cover;
    background-position: center 30%;
  }

  .gratitude-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 3, 22, 0.78) 0%,
      rgba(8, 3, 22, 0.72) 40%,
      rgba(8, 3, 22, 0.85) 100%
    );
  }

  .gratitude-content {
    position: relative;
    z-index: 1;
  }

  .gratitude-header {
    margin-bottom: 2.5rem;
  }

  .gratitude-header .eyebrow { margin-bottom: 0.75rem; }

  .gratitude-headline {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.1;
    margin: 0;
  }

  /* ── Cards layout ── */
  .cards-row-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
    align-items: start;
  }

  .cards-row-community {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* ── Supporter card base ── */
  .supporter-card {
    background: rgba(16, 10, 30, 0.88);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .supporter-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,0.22);
  }

  /* ── Card logo ── */
  .card-logo-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 8px;
    padding: 0.5rem 0.875rem;
    width: fit-content;
    height: 48px;
    overflow: hidden;
  }

  .card-logo-wrap.dark-logo {
    background: #0d0d0d;
    padding: 0.4rem 0.75rem;
  }

  .equimundo-img {
    display: block;
    max-height: 34px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
  }

  .tech-img {
    display: block;
    max-height: 30px;
    max-width: 110px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .blend-screen { mix-blend-mode: screen; }
  .invert { filter: invert(1); }

  /* ── Card text ── */
  .card-name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0;
  }

  .card-category {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin: 0;
  }

  .card-detail {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
    margin: 0;
  }

  .card-link {
    font-size: var(--text-sm);
    text-decoration: none;
    font-weight: 600;
    width: fit-content;
    margin-top: 0.25rem;
  }
  .card-link:hover { text-decoration: underline; }

  /* ── Per-card accent colors ── */
  .equimundo-name { color: #FFE600; }
  .card-link { color: #FFE600; }

  .autodesk-name  { color: #a78bfa; }
  .unreal-name    { color: #f97316; }
  .perforce-name  { color: #4ade80; }
  .community-name { color: #38bdf8; }

  /* Community card spans full width — just a single column row */
  .community-card {
    /* no extra styles needed */
  }

  /* ── Get Involved ── */
  .get-involved-section {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .get-involved-inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .get-involved-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .get-involved-cta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  /* ── Events Partners ── */
  .events-section {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .events-section .eyebrow { margin-bottom: 1rem; }
  .events-section .subheadline { margin-bottom: 2rem; }

  .events-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
    max-width: 680px;
    background: #16082e;
    border: 1.5px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 1.75rem 2rem;
  }

  .events-card .card-logo-wrap {
    flex-shrink: 0;
  }

  .events-card .card-detail {
    flex: 1;
  }

  .clubhouse-img {
    display: block;
    height: 52px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }

  /* ── Bottom CTA ── */
  .become-section {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .become-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .become-inner > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .become-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .become-note {
    font-size: var(--text-xs);
    color: var(--fg-3);
    max-width: 260px;
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .cards-row-main {
      grid-template-columns: 1fr 1fr;
    }
    .equimundo-card {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .cards-row-main { grid-template-columns: 1fr; }
    .equimundo-card { grid-column: auto; }
    .get-involved-inner,
    .become-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .get-involved-cta { justify-content: flex-start; }
    .events-card { flex-direction: column; align-items: flex-start; }
  }
</style>
