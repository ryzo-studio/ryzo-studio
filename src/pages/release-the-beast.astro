    min-width: 0;
  }

  .teaser-type {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .teaser-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--fg);
    margin: 0;
  }

  .teaser-venue {
    font-size: var(--text-xs);
    color: var(--fg-2);
    margin: 0;
    line-height: 1.4;
  }

  .events-teaser-cta {
    display: flex;
    justify-content: center;
  }

  /* Synopsis */
  .film-synopsis {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: start;
  }

  .synopsis-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .synopsis-text .eyebrow {
    margin-bottom: 0.5rem;
  }

  .synopsis-video-inline {
    margin-top: 0.5rem;
  }

  .film-player {
