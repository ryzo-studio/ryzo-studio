---
import Layout from '../layouts/Layout.astro';

const today = new Date();
const allEvents = [
  { date: new Date('2026-03-18'), title: 'UnTilted — Mastering the Internal OS with Ryzo', venue: 'Boys & Girls Clubs of San Leandro', type: 'Workshop' },
  { date: new Date('2026-04-15'), title: 'UnTilted — Mastering the Internal OS with Ryzo', venue: 'The Clubhouse Network @ TTC at MACLA', type: 'Workshop', venueLink: 'https://maclaarte.org/programs/ttc/' },
  { date: new Date('2026-04-16'), title: 'Story into Action: The Making of Rage Fighters', venue: 'The MADE · Oakland, CA', type: 'Panel & Demo' },
  { date: new Date('2026-04-18'), title: 'UnTilted — Mastering the Internal OS with Ryzo', venue: 'The MADE · Oakland, CA', type: 'Workshop' },
];
const upcomingEvents = allEvents.filter(e => e.date >= today).sort((a, b) => a.date.getTime() - b.date.getTime());
---

<Layout
  title="Release The Beast"
  description="An animated short film about a boy named Aaron who discovers that his rage isn't the enemy — it's the power he never learned to use."
>

  <!-- Film Hero -->
  <section class="film-hero">
    <div class="film-hero-bg">
      <img
        src="/images/rtb-hero-still.jpg"
        alt=""
        class="film-hero-img"
        aria-hidden="true"
      />
    </div>
    <div class="film-hero-overlay"></div>
    <div class="container film-hero-content">
      <div class="film-hero-left">
        <p class="eyebrow">Everything You Can't Contain</p>
        <h1 class="display">
          Release<br />
          <span class="accent-text">The Beast</span>
        </h1>
        <p class="film-hero-logline">A 12-minute animated film about anger, gaming, and the voices in your head that won't shut up.</p>
        <p class="film-hero-tagline">
          The monster inside isn't the villain.<br />It's the power you never learned to use.
        </p>
      </div>
      <div class="film-premiere">
        <p class="premiere-eyebrow">Premiering on YouTube</p>
        <p class="premiere-date">March 30, 2026</p>
        <div class="countdown" id="countdown">
          <div class="countdown-unit">
            <span class="countdown-num" id="cd-days">--</span>
            <span class="countdown-label">Days</span>
          </div>
          <span class="countdown-sep">:</span>
          <div class="countdown-unit">
            <span class="countdown-num" id="cd-hours">--</span>
            <span class="countdown-label">Hours</span>
          </div>
          <span class="countdown-sep">:</span>
          <div class="countdown-unit">
            <span class="countdown-num" id="cd-mins">--</span>
            <span class="countdown-label">Mins</span>
          </div>
          <span class="countdown-sep">:</span>
          <div class="countdown-unit">
            <span class="countdown-num" id="cd-secs">--</span>
            <span class="countdown-label">Secs</span>
          </div>
        </div>
        <a
          href="https://youtu.be/fGHBh76NHuI"
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >Save Your Seat →</a>
      </div>
    </div>
    <div class="film-hero-scroll-hint">
      <span>Scroll to explore</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- Upcoming Events Teaser -->
  {upcomingEvents.length > 0 && (
    <section class="events-teaser">
      <div class="container">
        <div class="events-teaser-header">
          <span class="eyebrow">Upcoming Events</span>
          <a href="/events" class="events-teaser-all">See all events →</a>
        </div>
        <div class="events-teaser-list">
          {upcomingEvents.map(event => (
            <div class="teaser-event-row">
              <div class="teaser-date">
                <span class="teaser-month">{event.date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}</span>
                <span class="teaser-day">{event.date.getDate()}</span>
              </div>
              <div class="teaser-body">
                <span class="teaser-type">{event.type}</span>
                <p class="teaser-title">{event.title}</p>
                <p class="teaser-venue">{event.venue}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="events-teaser-cta">
          <a href="/events" class="btn btn-primary">See All Events &amp; Locations →</a>
        </div>
      </div>
    </section>
  )}

  <!-- Synopsis -->
  <section class="section" id="about">
    <div class="container">
      <div class="film-synopsis">
        <div class="synopsis-text">
          <span class="eyebrow">The Story</span>
          <h2 class="subheadline">Aaron's got problems:</h2>
          <p class="body-lg">
            bullies at school, a game design contest deadline,
            and anger that won't quit. When his biggest rival humiliates him and even
            his mom can't help, something breaks — literally. His unfinished gaming
            character, Stan, explodes into the real world as multiple rage-fueled
            versions of himself.
          </p>
          <p class="body-lg">
            There's CG Stan (pure overwhelm), Paper Stan (a bodybuilder samurai stuck
            in a notebook), Sticky Stan (jealous and always watching), and more. Now
            Aaron's bedroom is a battlefield, his inner voices are running wild — and
            he has to figure out if the Stans will destroy everything or help him
            level up.
          </p>
          <p class="body-lg">
            Through tenacity, humor, and a willingness to follow the chaos all the
            way down, Aaron finds what's really underneath his anger — and learns to
            use it, not for destruction, but as fuel.
          </p>
          <div class="synopsis-video-inline">
            <div class="film-player">
              <video
                src="/rtb-hero.mp4"
                controls
                playsinline
                preload="metadata"
                class="film-video"
              ></video>
            </div>
          </div>
        </div>
        <div class="synopsis-room">
          <span class="eyebrow">Built for Your Room</span>
          <h2 class="subheadline">Tooled to<br />your audience.</h2>
          <div class="room-cards">
            <div class="room-card">
              <div class="room-card-header"><span class="room-icon">🎮</span><h3 class="room-card-title">Kids Ages 10–17</h3></div>
              <p class="room-card-body">Animation, gaming, and art in a single live experience that meets young people exactly where they are.</p>
            </div>
            <div class="room-card">
              <div class="room-card-header"><span class="room-icon">⚙️</span><h3 class="room-card-title">Adults &amp; Tinkerers</h3></div>
              <p class="room-card-body">Behind-the-scenes process talk — how story and impact get built together. Real talk for people who make things.</p>
            </div>
            <div class="room-card">
              <div class="room-card-header"><span class="room-icon">🎬</span><h3 class="room-card-title">Festivals</h3></div>
              <p class="room-card-body">A short film with big impact. Cinematic storytelling and a conversation worth having.</p>
            </div>
          </div>
          <a href="/events" class="btn btn-primary">See Events &amp; Locations →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Origin -->
  <section class="section origin-section">
    <div class="origin-bg" aria-hidden="true">
      <img src="/images/rtb-anger-bg.png" alt="" class="origin-bg-img" />
      <div class="origin-bg-overlay"></div>
    </div>
    <div class="container">
    <div class="origin-layout">
      <div class="origin-title-col">
        <h2 class="origin-display">our<br />take<br />on<br />anger</h2>
      </div>
      <div class="origin-body-col">
          <p class="body-lg">
            We live in an age where a boy's anger feels dangerous before it feels human.
            An angry kid can walk into a school and destroy everyone he associates with
            his pain. A moment of humiliation can become a reason to disappear. A digital
            bully can follow him home — stoking isolation and rage long past the public
            stage and into his most private moments.
          </p>
          <p class="body-lg origin-and-yet">And yet. Anger is not the enemy.</p>
          <p class="body-lg">
            Resentment, rage, rumination — these aren't malfunctions. They're protective
            instincts. Signals worth listening to. The problem isn't that boys feel too
            much. It's that we've given them almost no stories that walk through anger
            and show what lives on the other side.
          </p>
          <p class="body-lg">
            <em>Release the Beast</em> was built to be one of those stories.
          </p>
          <p class="body-lg">
            To make it, we sought out collaborators who had looked most constructively —
            and most compassionately — at boys. Researchers who study adolescent emotional
            development. Clinicians working directly with angry kids. Experts in applied
            anger management. And the boys themselves, who told us exactly what it feels
            like when no one has the right words for what's happening inside them.
          </p>
          <p class="body-lg">
            What we found was both humbling and galvanizing: the inner resources are
            already there. Boys don't need to be fixed. They need stories that take their
            inner lives seriously — and show them what those feelings are actually for.
          </p>
      </div>
    </div>
    </div>
  </section>

  <!-- Themes / Skills -->
  <section class="section themes-section">
    <div class="themes-bg" aria-hidden="true">
      <img src="/images/rtb-skills-bg.png" alt="" class="themes-bg-img" />
      <div class="themes-bg-overlay"></div>
    </div>
    <div class="container">
      <div class="themes-header">
        <div class="themes-header-text">
          <span class="eyebrow">What Kids Learn</span>
          <h2 class="subheadline">The skills inside<br />the story.</h2>
          <p class="body-lg">
            Our films open the door — our activations let audiences put their feelings into practice.
          </p>
        </div>
        <div class="themes-ecosystem">
            <div class="ecosystem-item">
            <span class="ecosystem-label">The Film</span>
            <p>
              <em>Release the Beast</em> is the mirror: boys see themselves in Aaron, a kid whose anger
              literally explodes out of his unfinished game. The film says <strong>you're not broken
              for feeling this much.</strong>
            </p>
            <div class="ecosystem-skills">
              <span class="skill-tag">⚡ Anger as Energy</span>
              <span class="skill-tag">🤝 Self-Compassion</span>
              <span class="skill-tag">🔥 Courage</span>
            </div>
          </div>
          <div class="ecosystem-item">
            <span class="ecosystem-label">The Game</span>
            <p>
              <em>Rage Fighters</em> is the next step — a free Roblox combat game where players fight
              enemies Aaron designed from his own inner world, using emotional regulation skills as real
              gameplay powers. The film helps boys recognize what they feel. The game gives them
              something to do about it.
            </p>
            <div class="ecosystem-skills">
              <span class="skill-tag">🌊 Emotional Regulation</span>
            </div>
            <a href="/rage-fighters" class="btn btn-outline btn-sm">Explore Rage Fighters →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Watch / Screen -->
  <section class="section screen-section" id="watch">
    <div class="screen-bg" aria-hidden="true">
      <img src="/images/rtb-screen-bg.jpg" alt="" class="screen-bg-img" />
      <div class="screen-bg-overlay"></div>
    </div>
    <div class="container">
      <div class="screen-inner">
        <h2 class="subheadline">Screen the film.</h2>
        <p class="body-lg">
          Bring "Release The Beast" to your school, library, community center,
          or festival. We partner with educators and organizers to make
          screenings meaningful — with discussion guides, activities, and live Q&amp;A.
        </p>
        <div class="screen-actions">
          <a href="/connect" class="btn btn-primary btn-lg">Request a Screening</a>
          <a href="/educators" class="btn btn-outline btn-lg">Educator Resources</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const target = new Date('2026-03-30T00:00:00-07:00').getTime();
      const days  = document.getElementById('cd-days');
      const hours = document.getElementById('cd-hours');
      const mins  = document.getElementById('cd-mins');
      const secs  = document.getElementById('cd-secs');
      if (!days) return;
      const pad = (n: number) => String(n).padStart(2, '0');
      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const el = document.getElementById('countdown');
          if (el) el.innerHTML = '<span class="countdown-live">Streaming Now</span>';
          return;
        }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        days.textContent  = String(d);
        hours.textContent = pad(h);
        mins.textContent  = pad(m);
        secs.textContent  = pad(s);
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <!-- Companion Game CTA -->
  <section class="section-sm game-cta">
    <div class="container">
      <div class="game-cta-inner">
        <div>
          <span class="tag tag-accent">Companion Experience</span>
          <h3 class="game-cta-title">Continue the journey<br />in Rage Fighters.</h3>
          <p>The Roblox game where kids battle emotional enemies using the same skills from the film.</p>
        </div>
        <a href="/rage-fighters" class="btn btn-outline btn-lg">Explore the Game →</a>
      </div>
    </div>
  </section>


</Layout>

<style>
  .film-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 8rem 5rem;
    position: relative;
    overflow: hidden;
  }

  .film-hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .film-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .film-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 60% 30%, rgba(232, 53, 42, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 90% 70%, rgba(124, 92, 191, 0.15) 0%, transparent 45%),
      linear-gradient(to bottom, rgba(8, 3, 22, 0.22) 0%, rgba(8, 3, 22, 0.55) 100%);
  }

  /* Shared background for all sections */
  .section,
  .section-sm {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
  }

  .film-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: flex-end;
  }

  .film-hero-left {
    display: flex;
    flex-direction: column;
  }

  .film-hero-left .eyebrow {
    margin-bottom: 1.25rem;
  }

  .display {
    font-size: clamp(4rem, 12vw, 10rem);
    margin-bottom: 1.5rem;
  }

  .accent-text {
    color: #E8352A;
  }

  /* Page-specific accent override */
  .eyebrow {
    color: #E8352A;
  }

  .btn-primary {
    background: #E8352A;
    color: #fff;
  }

  .btn-primary:hover {
    background: #ff4438;
  }

  .film-hero-logline {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 0.75rem;
    max-width: 520px;
  }

  .film-hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.5;
    margin-bottom: 2.5rem;
  }

  .film-premiere {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-end;
    text-align: right;
  }

  .premiere-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #E8352A;
  }

  .premiere-date {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: rgba(255,255,255,0.88);
    margin-top: -0.25rem;
  }

  .countdown {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    min-width: 3.5rem;
  }

  .countdown-num {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .countdown-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.70);
  }

  .countdown-sep {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900;
    color: rgba(255,255,255,0.45);
    padding-bottom: 1rem;
    line-height: 1;
  }

  .coming-soon-splash {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    border: 1px solid rgba(232, 53, 42, 0.4);
    border-radius: var(--radius-lg);
    background: rgba(232, 53, 42, 0.08);
  }

  .coming-soon-label {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E8352A;
  }

  .countdown-live {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: #E8352A;
  }

  .film-hero-scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    z-index: 1;
  }

  .film-hero-scroll-hint span {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--fg-3), transparent);
  }

  /* Events Teaser */
  .events-teaser {
    background: linear-gradient(to right, #0d0420 0%, #150628 100%);
    border-top: 1px solid rgba(232, 53, 42, 0.25);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    padding-block: 2.5rem;
  }

  .events-teaser-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .events-teaser-all {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255,255,255,0.2);
    transition: color 0.2s;
  }

  .events-teaser-all:hover {
    color: #E8352A;
    text-decoration-color: #E8352A;
  }

  .events-teaser-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .teaser-event-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
