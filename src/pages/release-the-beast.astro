  }

  .room-card {
    background: var(--bg-2);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .room-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .room-icon {
    font-size: 1rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .room-card-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--fg);
    margin: 0;
  }

  .room-card-body {
    font-size: var(--text-xs);
    color: var(--fg-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Themes */
