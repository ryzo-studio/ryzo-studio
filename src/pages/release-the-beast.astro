    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
    line-height: 1;
  }

  .teaser-month {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #E8352A;
    line-height: 1;
  }

  .teaser-day {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #fff;
