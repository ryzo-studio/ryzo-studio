---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="For Investors"
  description="See where Ryzo Studios is headed next and opportunities to participate."
>

  <section class="investor-page">
    <div class="container">
      <div class="video-container">
        <video
          controls
          preload="metadata"
          playsinline
          class="investor-video"
        >
          <source src="/ryzo-pitch.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>

      <div class="cta-box">
        <h2 class="cta-heading">Let's talk.</h2>
        <p class="cta-body">
          If you're interested in where Ryzo is headed and want to be part of it, book a time with Erica.
        </p>
        <a href="https://calendar.app.google/XKDMdVeDkciK6x34A" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
          Schedule a Conversation
        </a>
        <a href="/" class="back-link">Back to Ryzo Studios</a>
      </div>
    </div>
  </section>

</Layout>


<style>
  .investor-page {
    padding: 10rem 0 6rem;
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    min-height: 100vh;
  }

  .video-container {
    max-width: 900px;
    margin: 0 auto 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: #000;
  }

  .investor-video {
    display: block;
    width: 100%;
    height: auto;
  }

  .cta-box {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .cta-body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 0.5rem;
  }

  .back-link {
    font-size: var(--text-sm);
    color: var(--fg-3);
    transition: color var(--transition);
    margin-top: 0.5rem;
  }

  .back-link:hover {
    color: var(--accent);
  }
</style>
