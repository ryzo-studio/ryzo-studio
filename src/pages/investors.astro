---
// ryzo.studio/investors — kid's desk layout.
// Standalone page: no site header/footer by design (only a back link to the home page).
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>For Investors — Ryzo Studios</title>
<meta name="description" content="See where Ryzo Studios is headed next and opportunities to participate.">
<link rel="canonical" href="https://www.ryzo.studio/investors">
<meta name="robots" content="index, follow">
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.ryzo.studio/investors">
<meta property="og:title" content="For Investors — Ryzo Studios">
<meta property="og:description" content="See where Ryzo Studios is headed next and opportunities to participate.">
<meta property="og:image" content="https://www.ryzo.studio/images/investors/pitch-poster.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="For Investors — Ryzo Studios">
<meta name="twitter:description" content="See where Ryzo Studios is headed next and opportunities to participate.">
<meta name="twitter:image" content="https://www.ryzo.studio/images/investors/pitch-poster.jpg">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preload" as="image" href="/images/investors/desk-desktop.jpg" media="(min-aspect-ratio: 4/5)">
<link rel="preload" as="image" href="/images/investors/desk-phone.jpg" media="(max-aspect-ratio: 4/5)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@800;900&amp;family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&amp;family=Permanent+Marker&amp;display=swap" rel="stylesheet">
<style is:global>
body{margin:0;background:#16091b}
a{color:#ffffff}a:hover{color:#f5c842}
.stage{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background-size:100% 100%;background-repeat:no-repeat}
.st-desk{--u:calc(max(100vw,160vh) / 1440);width:max(100vw,160vh);height:max(62.5vw,100vh);background-image:url(/images/investors/desk-desktop.jpg)}
.st-phone{display:none;--u:calc(max(100vw,46.21vh) / 390);width:max(100vw,46.21vh);height:max(216.4vw,100vh);background-image:url(/images/investors/desk-phone.jpg)}
@media (max-aspect-ratio:4/5){.st-desk{display:none}.st-phone{display:block}}
.back:hover{color:#f5c842 !important}
.torn{background:url(/images/investors/torn-paper.png) center/100% 100% no-repeat}
.cta{transition:transform .15s ease,box-shadow .15s ease}
.cta:hover{background:#f03a33 !important;transform:translateY(-2px) rotate(-1.5deg)}
.cta:active{transform:translateY(2px);box-shadow:0 1px 0 #7e1714 !important}
</style>
</head>
<body>
<div style="position:relative;height:100vh;min-height:520px;overflow:hidden;background:#16091b;font-family:'DM Sans',Arial,sans-serif;color:#1a0b22">

  <div class="stage st-desk">
    <div style="position: absolute; left: 18.75%; top: 12.89%; width: 72%; box-sizing: border-box; padding: calc(var(--u)*10); border-radius: calc(var(--u)*18); background: linear-gradient(150deg,#2b2333,#0b070e); box-shadow: 0 calc(var(--u)*30) calc(var(--u)*70) rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.07) inset; display: block">
      <video controls="" playsinline="" preload="none" poster="/images/investors/pitch-poster.jpg" src="/ryzo-pitch.mp4" style="display:block;width:100%;aspect-ratio:16/9;height:auto;border-radius:calc(var(--u)*9);background:#000"></video>
    </div>
    
  <div style="position: absolute; left: 84.1%; top: 73.67%; width: 13.9%; aspect-ratio: 1; box-sizing: border-box; padding: calc(var(--u)*16) calc(var(--u)*16) calc(var(--u)*15); justify-content: center; transform: rotate(-4deg); background: linear-gradient(170deg,#f8e27a 0%,#f1d55c 70%,#e9c94c 100%); box-shadow: 0 calc(var(--u)*20) calc(var(--u)*34) rgba(0,0,0,.55); display: flex; flex-direction: column; gap: calc(var(--u)*8)">
      <span aria-hidden="true" style="position:absolute;top:calc(var(--u)*-11);left:50%;width:calc(var(--u)*70);height:calc(var(--u)*20);margin-left:calc(var(--u)*-35);transform:rotate(-4deg);background:rgba(255,255,240,.55);box-shadow:0 1px 3px rgba(0,0,0,.2)"></span>
      <h1 style="margin:0;font-family:Archivo,'Arial Black',sans-serif;font-weight:900;font-size:calc(var(--u)*26);line-height:1;letter-spacing:-.02em">Let’s talk.</h1>
      <p style="margin:0;font-size:calc(var(--u)*12.5);line-height:1.4;color:#3a2a3f">You’ve seen the work. Now see the plan: book a call with Erica to back the studio or a story.</p>
      <a class="cta" href="https://calendar.app.google/XKDMdVeDkciK6x34A" style="margin-top:calc(var(--u)*6);align-self:stretch;display:flex;justify-content:center;align-items:center;min-height:max(44px,calc(var(--u)*40));padding:0 calc(var(--u)*6);border-radius:calc(var(--u)*10);background:#e3302a;color:#fff7e6;font-family:Archivo,'Arial Black',sans-serif;font-weight:800;letter-spacing:.01em;white-space:nowrap;font-size:calc(var(--u)*11.5);text-decoration:none;box-shadow:0 calc(var(--u)*4) 0 #7e1714,0 calc(var(--u)*8) calc(var(--u)*14) rgba(126,23,20,.45)">Schedule a Conversation</a>
    </div></div>

  <div class="stage st-phone">
    <!-- Spotlight: darkens the busy desk in a soft band behind the video so it stands out. -->
    <div aria-hidden="true" style="position:absolute;left:calc(50% - 50vw);width:100vw;top:15%;height:42%;pointer-events:none;background:linear-gradient(to bottom,rgba(10,4,14,0) 0%,rgba(10,4,14,.82) 24%,rgba(10,4,14,.88) 50%,rgba(10,4,14,.82) 76%,rgba(10,4,14,0) 100%)"></div>
    <!-- Full-frame video: edge to edge across the screen, no bezel. -->
    <div style="position:absolute;left:calc(50% - 50vw);width:100vw;top:23%;box-shadow:0 calc(var(--u)*22) calc(var(--u)*50) rgba(0,0,0,.85),0 0 calc(var(--u)*60) rgba(255,176,102,.22);border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)">
      <video controls="" preload="none" data-phone-video poster="/images/investors/pitch-poster.jpg" src="/ryzo-pitch.mp4" style="display:block;width:100%;aspect-ratio:16/9;height:auto;background:#000"></video>
    </div>
    <div style="position:absolute;left:7%;top:51.2%;width:78%;transform:rotate(-1.2deg)">
      <!-- Paper and its shadow sit on their own layer so the text is never inside the filter (some browsers drop text painted inside a drop-shadow filter). -->
      <span class="torn" aria-hidden="true" style="position:absolute;inset:0;filter:drop-shadow(0 calc(var(--u)*8) calc(var(--u)*10) rgba(0,0,0,.55))"></span>
      <p style="position:relative;margin:0;padding:calc(var(--u)*22) calc(var(--u)*20) calc(var(--u)*24);font-size:calc(var(--u)*14);line-height:1.45;color:#2e2235">You’ve seen the work. Now see the plan: book a call with Erica to back the studio or a story.</p>
    </div>
    <div style="position:absolute;left:55%;top:60.2%;width:35%;aspect-ratio:1;box-sizing:border-box;padding:calc(var(--u)*11) calc(var(--u)*10) calc(var(--u)*10);justify-content:center;transform:rotate(-4deg);background:linear-gradient(170deg,#f8e27a 0%,#f1d55c 70%,#e9c94c 100%);box-shadow:0 calc(var(--u)*12) calc(var(--u)*22) rgba(0,0,0,.55);display:flex;flex-direction:column;gap:calc(var(--u)*6)">
      <span aria-hidden="true" style="position:absolute;top:calc(var(--u)*-8);left:50%;width:calc(var(--u)*50);height:calc(var(--u)*14);margin-left:calc(var(--u)*-25);transform:rotate(-4deg);background:rgba(255,255,240,.55)"></span>
      <h1 style="margin:0;font-family:Archivo,'Arial Black',sans-serif;font-weight:900;font-size:calc(var(--u)*19);line-height:1;letter-spacing:-.02em">Let’s talk.</h1>
      <a class="cta" href="https://calendar.app.google/XKDMdVeDkciK6x34A" style="align-self:stretch;display:flex;justify-content:center;align-items:center;text-align:center;min-height:44px;padding:calc(var(--u)*5) calc(var(--u)*6);border-radius:calc(var(--u)*8);background:#e3302a;color:#fff7e6;font-family:Archivo,'Arial Black',sans-serif;font-weight:800;line-height:1.12;font-size:calc(var(--u)*11);text-decoration:none;box-shadow:0 calc(var(--u)*3) 0 #7e1714,0 calc(var(--u)*6) calc(var(--u)*12) rgba(126,23,20,.45)">Schedule a Conversation</a>
    </div>
  </div>

  <a class="back" href="https://www.ryzo.studio/" style="position:absolute;z-index:5;top:20px;left:24px;display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 14px 0 10px;border-radius:999px;background:rgba(14,6,18,.6);color:#e9e2ee;font-size:15px;font-weight:500;text-decoration:none"><span aria-hidden="true" style="font-size:18px">←</span><img src="/images/investors/ryzo-logo.png" alt="Ryzo Studios home" style="height:26px;width:auto;display:block"></a>

</div>
<script>
  // On phones, playing the pitch opens it full screen.
  document.querySelectorAll('video[data-phone-video]').forEach((v) => {
    v.addEventListener('play', () => {
      if (!window.matchMedia('(max-aspect-ratio: 4/5)').matches || document.fullscreenElement) return;
      if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
      else if (v.webkitEnterFullscreen) v.webkitEnterFullscreen();
    });
  });
</script>
</body>
</html>
