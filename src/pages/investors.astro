---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="For Investors"
  description="See where Ryzo Studios is headed next and opportunities to participate."
>

  <section class="investor-hero">
    <div class="container">
      <span class="eyebrow">For Investors</span>
      <h1 class="display investor-headline">Where we're headed next.</h1>
      <p class="investor-intro">
        We make films, games, and live events for kids 10 and up about
        the things that sometimes feel too big to handle. Then we show
        them what to do with it. Watch the short video below to see where
        we're going and how you can be part of it.
      </p>
    </div>
  </section>

  <section class="investor-video-section">
    <div class="container">
      <div class="video-container">
        <video
          controls
          preload="metadata"
          playsinline
          class="investor-video"
        >
          <source src="/ryzo-pitch.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </section>

  <section class="investor-cta-section">
    <div class="container">
      <div class="cta-box">
        <h2 class="cta-heading">Want to learn more?</h2>
        <p class="cta-body">
          If you're interested in learning more about Ryzo Studios and
          opportunities to participate, we'd love to hear from you.
        </p>
        <a href="mailto:hello@ryzo.studio?subject=Investor%20Inquiry" class="btn btn-primary btn-lg">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

</Layout>


<style>
  .investor-hero {
    padding: 10rem 0 4rem;
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
  }

  .investor-headline {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin-bottom: 1.5rem;
    line-height: 1;
    color: #f5f0ff;
  }

  .investor-intro {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: rgba(210, 200, 240, 0.75);
    line-height: 1.7;
    max-width: 600px;
  }

  .investor-video-section {
    padding: 3rem 0 4rem;
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .video-container {
    max-width: 900px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: #000;
  }

  .investor-video {
    display: block;
    width: 100%;
    height: auto;
  }

  .investor-cta-section {
    padding: 4rem 0 6rem;
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .cta-box {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .cta-body {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }
</style>
