---
import Layout from '../layouts/Layout.astro';

const today = new Date();

const allEvents = [
  {
    id: 'e9',
    date: new Date('2026-03-30'),
    title: 'Release the Beast — YouTube Premiere Party',
    venue: 'Virtual Event · Hosted by Ryzo',
    type: 'Film Premiere',
    audience: 'For Everyone',
    link: 'https://luma.com/fl72b5hz',
  },
  {
    id: 'e8',
    date: new Date('2026-04-15'),
    title: 'UnTilted — Mastering the Internal OS with Ryzo',
    venue: 'The Clubhouse Network @ TTC at MACLA',
    venueLink: 'https://maclaarte.org/programs/ttc/',
    type: 'Live Event',
    audience: 'For Young People',
    link: null,
  },
  {
    id: 'e6',
    date: new Date('2026-03-18'),
    title: 'UnTilted — Mastering the Internal OS with Ryzo',
    venue: 'The Clubhouse Network · The Tech Center @ Boys & Girls Clubs of San Leandro',
    type: 'Live Event',
    audience: 'For Young People',
    link: null,
  },
  {
    id: 'e4',
    date: new Date('2026-04-16'),
    title: 'Story into Action: The Making of Rage Fighters',
    venue: 'The MADE · Oakland, CA',
    venueLink: 'https://www.themade.org/visit',
    type: 'Talk',
    audience: 'For Creators',
    link: 'https://www.eventbrite.com/e/story-into-action-the-making-of-rage-fighters-with-erica-milsom-the-ryzo-tickets-1985640418945?aff=ebdsshcopyurl&utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=organizer-profile&utm-share-source=organizer-profile',
  },
  {
    id: 'e5',
    date: new Date('2026-04-18'),
    title: 'UnTilted — Mastering the Internal OS with Ryzo',
    venue: 'The MADE · Oakland, CA',
    venueLink: 'https://www.themade.org/visit',
    type: 'Live Event',
    audience: 'For Young People',
    link: 'https://www.eventbrite.com/e/untilted-with-erica-milsom-founder-of-ryzo-studios-former-pixar-director-tickets-1985640564380?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl',
  },
  {
    id: 'e7',
    date: new Date('2026-02-26'),
    title: 'Understanding Anger in Young Men — feat. Erica Milsom',
    venue: 'Ever Forward Club · Advocates for Young Men (Skool)',
    type: 'Guest Speaker',
    audience: 'For Creators',
    link: null,
  },
  {
    id: 'e3',
    date: new Date('2025-12-14'),
    title: 'Release The Beast — Supporter Sneak Peek',
    venue: 'The Roxie Theater · San Francisco, CA',
    type: 'Film Screening',
    audience: 'For Creators',
    link: null,
  },
  {
    id: 'e1',
    date: new Date('2025-01-09'),
    title: 'UnTilted Betatest with the Colorado Clubhouse Network',
    venue: 'Edgewood, CO',
    type: 'Community Visit',
    audience: 'For Young People',
    link: null,
  },
  {
    id: 'e2',
    date: new Date('2025-01-08'),
    title: 'UnTilted Betatest with the Colorado Clubhouse Network',
    venue: 'Lakewood, CO',
    type: 'Community Visit',
    audience: 'For Young People',
    link: null,
  },
];

const upcoming = allEvents.filter(e => e.date >= today);
const past = allEvents.filter(e => e.date < today);
const nextPublic = upcoming.filter(e => e.link).slice(0, 2);
---

<Layout
  title="Ryzo Events"
  description="Screenings, panels, and community gatherings — Ryzo brings the story into the room."
>

  <section class="events-hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-left">
        <span class="eyebrow">Events</span>
        <h1 class="display">
          Where we<br /><span class="accent-text">show up.</span>
        </h1>
        <p class="hero-sub">
          Screenings, panels, and live gatherings.<br />
          <a href="mailto:hello@ryzo.studio?subject=EVENT%20REQUEST">Invite us to your community →</a>
        </p>
      </div>
      {nextPublic.length > 0 && (
        <div class="hero-next">
          <p class="next-eyebrow">Coming Up</p>
          <div class="hero-next-events">
            {nextPublic.map(event => (
              <div class="hero-next-event">
                <div class="hero-next-date">
                  <span class="hn-month">{event.date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}</span>
                  <span class="hn-day">{event.date.getDate()}</span>
                </div>
                <div class="hero-next-body">
                  <p class="hero-next-title">{event.title}</p>
                  <p class="hero-next-venue">{event.venue}</p>
                </div>
                <a href={event.link} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                  Get on the List →
                </a>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="audience-section">
    <div class="container">
      <span class="eyebrow">Built for Your Room</span>
      <h2 class="audience-headline">Ryzo Events can be tooled<br /><span class="accent-text">to your audience.</span></h2>
      <div class="audience-grid">
        <div class="audience-card">
          <div class="audience-header"><span class="audience-icon">🎮</span><h3 class="audience-title">Kids Ages 10–17</h3></div>
          <p class="audience-body">We bring the full combo — animation, gaming, and art — into a single live experience that meets young people exactly where they are.</p>
        </div>
        <div class="audience-card">
          <div class="audience-header"><span class="audience-icon">⚙️</span><h3 class="audience-title">Adults &amp; Tinkerers</h3></div>
          <p class="audience-body">We go behind the scenes and talk process — how story and impact get built together inside a digital-forward world. Real talk for people who make things.</p>
        </div>
        <div class="audience-card">
          <div class="audience-header"><span class="audience-icon">🎬</span><h3 class="audience-title">Festivals</h3></div>
          <p class="audience-body">A short film with big impact. Ryzo brings cinematic storytelling and a conversation worth having — wherever great work is being shown.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="events-list-section">
    <div class="container">

      {upcoming.length > 0 && (
        <div class="events-block">
          {upcoming.map(event => (
            <div class="event-row">
              <div class="event-date">
                <span class="e-month">{event.date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}</span>
                <span class="e-day">{event.date.getDate()}</span>
              </div>
              <div class="event-body">
                <div class="event-meta">
                  <span class="event-type">{event.type}</span>
                  <span class="event-audience">{event.audience}</span>
                </div>
                <h2 class="event-title">{event.title}</h2>
                <p class="event-venue">
                  {event.venueLink
                    ? <a href={event.venueLink} target="_blank" rel="noopener" class="venue-link">{event.venue}</a>
                    : event.venue}
                </p>
              </div>
              {event.link
                ? <a href={event.link} class="btn btn-primary" target="_blank" rel="noopener">Get on the List</a>
                : <span class="event-private">Private</span>
              }
            </div>
          ))}
        </div>
      )}

      {past.length > 0 && (
        <div class="events-block past-block">
          <div class="past-divider">
            <span>Past Events</span>
          </div>
          {past.map(event => (
            <div class="event-row is-past">
              <div class="event-date">
                <span class="e-month">{event.date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}</span>
                <span class="e-day">{event.date.getDate()}</span>
              </div>
              <div class="event-body">
                <div class="event-meta">
                  <span class="event-type">{event.type}</span>
                  <span class="event-audience">{event.audience}</span>
                </div>
                <h2 class="event-title">{event.title}</h2>
                <p class="event-venue">
                  {event.venueLink
                    ? <a href={event.venueLink} target="_blank" rel="noopener" class="venue-link">{event.venue}</a>
                    : event.venue}
                </p>
              </div>
            </div>
          ))}
        </div>
      )}

      <div class="events-cta">
        <p>Want to bring Ryzo to your community?</p>
        <a href="/connect" class="btn btn-outline">Send an Inquiry</a>
      </div>

    </div>
  </section>

  <section class="live-materials-section">
    <div class="container">
      <span class="eyebrow">Event Materials</span>
      <h2 class="live-materials-heading">Live Event <span class="accent-text">Materials</span></h2>
      <p class="live-materials-sub">Facilitator guides, activity sheets, and supporting assets for Ryzo live events.</p>
      <a
        href="https://drive.google.com/drive/folders/1T4C8-G92TzJHGjXUx97_pR8M576yOnmu?usp=drive_link"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        Open Live Event Materials →
      </a>
    </div>
  </section>


</Layout>

<style>
  /* Hero */
  .events-hero {
    min-height: 52vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 7rem 3.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/events-hero.png');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8, 3, 22, 0.70) 0%, rgba(8, 3, 22, 0.20) 50%, transparent 100%),
      linear-gradient(to top, rgba(8, 3, 22, 0.60) 0%, transparent 40%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: flex-end;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
  }

  .hero-left .eyebrow { margin-bottom: 1.5rem; }

  .display {
    font-size: clamp(3.5rem, 9vw, 8rem);
    margin-bottom: 1.25rem;
  }

  .accent-text { color: var(--accent); }

  .hero-sub {
    font-size: var(--text-base);
    color: var(--fg-2);
    line-height: 1.6;
  }

  .hero-sub a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Coming Up column inside hero */
  .hero-next {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 320px;
    max-width: 400px;
  }

  .next-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .hero-next-events {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-next-event {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 0.75rem 1rem;
    align-items: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-lg);
    padding: 0.85rem 1rem;
  }

  .hero-next-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .hn-month {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    line-height: 1;
  }

  .hn-day {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--fg);
  }

  .hero-next-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .hero-next-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-next-venue {
    font-size: var(--text-xs);
    color: var(--fg-2);
    line-height: 1.3;
  }

  /* Audience section */
  .audience-section {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    padding-block: 1.75rem 0.5rem;
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .audience-section .eyebrow { margin-bottom: 0.5rem; }

  .audience-headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .audience-card {
    background: var(--bg-2);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-xl);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .audience-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .audience-icon {
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .audience-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--fg);
    margin: 0;
  }

  .audience-body {
    font-size: var(--text-xs);
    color: var(--fg-2);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Events list section */
  .events-list-section {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .events-block {
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  /* Individual event row */
  .event-row {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 2.5rem;
    align-items: center;
    padding: 2.25rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: var(--transition);
  }

  .event-row:not(.is-past):hover .event-title {
    color: var(--accent);
  }

  /* Date column */
  .event-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .e-month {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    line-height: 1;
    opacity: 1;
  }

  .e-day {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--fg);
  }

  /* Body column */
  .event-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .event-type {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg);
  }

  .event-audience {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    border: 1px solid rgba(245, 200, 66, 0.35);
    border-radius: 999px;
    padding: 0.1em 0.6em;
  }

  .event-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    transition: color var(--transition);
  }

  .event-venue {
    font-size: var(--text-base);
    color: var(--fg-2);
    margin-top: 0.125rem;
  }

  .venue-link {
    color: var(--fg-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255,255,255,0.25);
    transition: color 0.2s;
  }

  .venue-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .event-private {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-3);
    white-space: nowrap;
  }

  /* Past events */
  .past-divider {
    padding: 2rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    margin-top: 1rem;
  }

  .past-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.05);
  }

  .past-divider span {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-3);
    white-space: nowrap;
  }

  .is-past {
    opacity: 0.35;
  }

  .is-past .e-month { color: rgba(255,255,255,0.50); }
  .is-past .e-day { color: var(--fg-2); }

  /* Bottom CTA */
  .events-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 3rem;
    flex-wrap: wrap;
  }

  .events-cta p {
    font-size: var(--text-base);
    color: var(--fg-2);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
    }
    .hero-next {
      min-width: 0;
      max-width: 100%;
    }
  }

  /* Live Event Materials */
  .live-materials-section {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .live-materials-section .eyebrow {
    margin-bottom: 1rem;
  }

  .live-materials-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .live-materials-sub {
    font-size: var(--text-base);
    color: var(--fg-2);
    max-width: 540px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .event-row {
      grid-template-columns: 60px 1fr;
      gap: 1.5rem;
    }

    .event-row .btn,
    .event-row .event-private {
      grid-column: 2;
    }

    .e-day { font-size: clamp(2rem, 8vw, 3rem); }

    .events-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
