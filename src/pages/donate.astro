---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Donate"
  description="Support Ryzo Studios with a tax-deductible donation through our fiscal sponsor, Youth Media Foundation. 100% of every gift goes directly to the work."
>

  <section class="donate-hero">
    <div class="container">
      <div class="donate-grid">
        <div class="donate-text">
          <span class="eyebrow">Support the Work</span>
          <h1 class="donate-headline">
            Give kids stories<br />
            <span class="accent-text">built for them.</span>
          </h1>
          <p class="donate-lede">
            Every gift powers our Impact Franchise model — story worlds built across
            film, games, and live events that meet kids where they live. Right now,
            that means deepening our first franchise for boys and beginning development
            on our second. <strong>Donations are fully tax-deductible</strong> through our fiscal
            sponsor, Youth Media Foundation, and 100% of every gift goes directly to
            the work.
          </p>
        </div>

        <div class="donate-card">
          <span class="card-kicker">Tax-Deductible Giving</span>
          <a
            href="https://secure.lglforms.com/form_engine/s/Vl4n9NT5Rdj2w6OylYlQXw"
            target="_blank"
            rel="noopener"
            class="btn btn-primary btn-lg donate-btn"
          >
            Donate Now →
          </a>
          <p class="donate-fine-print">
            Processed securely by Youth Media Foundation, a 501(c)(3) nonprofit, on
            behalf of Ryzo Studios. 100% of your donation reaches the work, and you'll
            receive a receipt for tax purposes.
          </p>
          <p class="donate-fine-print">
            Prefer check, ACH, wire, or stock? <a href="mailto:hello@ryzo.studio?subject=Donation%20to%20Ryzo" class="fine-print-link">Email us</a> for instructions.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .donate-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-block: 8rem 5rem;
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
  }

  .donate-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .donate-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .donate-headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.0;
  }

  .accent-text {
    color: var(--accent);
    font-style: normal;
  }

  .donate-lede {
    font-size: clamp(var(--text-base), 1.5vw, var(--text-xl));
    line-height: 1.7;
    color: var(--fg-2);
    max-width: 540px;
  }

  .donate-lede strong {
    color: var(--fg);
    font-weight: 600;
  }

  .donate-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card-kicker {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--purple);
  }

  .donate-btn {
    align-self: flex-start;
    font-size: var(--text-lg);
    padding: var(--s-4) var(--s-10);
  }

  .donate-fine-print {
    font-size: var(--text-sm);
    color: var(--fg-3);
    line-height: 1.65;
  }

  .fine-print-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .fine-print-link:hover {
    color: var(--accent-light);
  }

  @media (max-width: 768px) {
    .donate-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .donate-hero {
      padding-block: 7rem 3rem;
      min-height: auto;
    }
  }
</style>
