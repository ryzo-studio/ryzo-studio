---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Rage Fighters"
  description="A melee fighting game on Roblox — built by Aaron, the hero of Release The Beast, to process the emotional storm inside him. Fight through emotional chaos, master your rage, and evolve into an unstoppable force."
>

  <!-- Game Hero -->
  <section class="game-hero">
    <div class="game-hero-bg"></div>
    <div class="container game-hero-content">
      <div class="hero-eyebrow">
        <p class="eyebrow">Roblox</p>
        <span class="live-badge">Live Now</span>
      </div>
      <h1 class="display">
        Rage<br />
        <span class="purple-text">Fighters</span>
      </h1>
      <p class="hero-tagline">
        Fight through emotional chaos,<br />
        master your rage, and evolve<br />
        into something unstoppable.
      </p>
      <div class="hero-actions">
        <a href="https://www.roblox.com/games/106511362279091/Rage-Fighters" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Play Now</a>
      </div>
      <p class="production-credit-mobile">A Ryzo Studios × Equimundo production</p>
    </div>
    <p class="production-credit">A Ryzo Studios × Equimundo production</p>
  </section>

  <!-- About the Game -->
  <section class="section">
    <div class="container">
      <div class="game-about">
        <div>
          <span class="eyebrow">What It Is</span>
          <h2 class="subheadline">Built by Aaron.<br />Played by everyone.</h2>
          <p class="body-lg">
            Rage Fighters is a melee fighter on Roblox set inside the world
            of <em>Release the Beast</em>. The conceit is that Aaron built it
            himself, to handle the emotional storm going on inside him.
          </p>
          <p class="body-lg">
            The genre came from the audience. Boys who watched early screenings
            named the emotions immediately: anger, fear, shame, frustration.
            When we asked what kind of game they wanted, they said a fighter.
          </p>
        </div>
        <div class="game-preview">
          <video
            class="game-video"
            src="/images/RageFighters_AaronIntro.m4v"
            autoplay
            muted
            loop
            playsinline
          ></video>
          <div class="game-specs">
            <div class="spec"><span class="spec-label">Platform</span><span>Roblox</span></div>
            <div class="spec"><span class="spec-label">Ages</span><span>Recommended 10+</span></div>
            <div class="spec"><span class="spec-label">Type</span><span>Melee fighter</span></div>
            <div class="spec"><span class="spec-label">Price</span><span>Free</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Battlegrounds -->
  <section class="section zones-section">
    <div class="container">
      <span class="eyebrow">The Battlegrounds</span>
      <h2 class="subheadline">Know where<br />you're fighting.</h2>
      <div class="zones-grid">
        {[
          {
            name: 'EmoDojo',
            color: '#7C5CBF',
            symbol: '⚔️',
            desc: 'The training ground, where players first face the emotional enemies that have been running the show.'
          },
          {
            name: 'Rage Storm',
            color: '#FF3D00',
            symbol: '🌪️',
            desc: 'Overwhelming, explosive, disorienting. Losing control of it is the real danger.'
          },
          {
            name: 'Toxic Zone',
            color: '#2d6a4f',
            symbol: '☠️',
            desc: 'Where the inner critics live. Shame, self-doubt, the voice that says you\'re the problem. It\'s the most challenging zone in the game.'
          },
        ].map(({ name, color, symbol, desc }) => (
          <div class="zone-card" style={`--zone-color: ${color}`}>
            <div class="zone-symbol">{symbol}</div>
            <h3 class="zone-name">{name}</h3>
            <p class="zone-desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section skills-section">
    <div class="container">
      <div class="skills-inner">
        <div class="skills-text">
          <span class="eyebrow">The Mechanics</span>
          <h2 class="subheadline">Real skills.<br />Real power.</h2>
          <p class="body-lg">
            Players unlock skills that work as game mechanics and as actual
            emotional tools. Every move maps to something a player can use
            outside the game.
          </p>
        </div>
        <div class="skills-list">
          {[
            { num: '01', skill: 'Pause', mechanic: 'Force field and teleport', desc: 'In game: throws up a protective field and gets you out. In life: the moment before the reaction.' },
            { num: '02', skill: 'Breathe', mechanic: 'Restore health', desc: 'In game: restores health and calms the chaos around you. In life: the physiological reset that changes what happens next.' },
            { num: '03', skill: 'Chill', mechanic: 'Environmental advantage', desc: 'In game: turns the environment to your advantage instead of your fists. In life: changing your situation when your head won\'t change.' },
          ].map(({ num, skill, mechanic, desc }) => (
            <div class="skill-step">
              <span class="skill-num">{num}</span>
              <div>
                <h3 class="skill-title">{skill}</h3>
                <span class="skill-mechanic">{mechanic}</span>
                <p class="skill-desc">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Aaron's Notebook -->
  <section class="section notebook-section">
    <div class="container">
      <div class="notebook-inner">
        <div class="notebook-text">
          <span class="eyebrow">Hidden Layer</span>
          <h2 class="subheadline">Aaron's notebook.</h2>
          <p class="body-lg">
            Hidden pages scattered through the game show how Aaron built
            Rage Fighters, and how he folded real emotional skills into
            the mechanics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Attribution -->
  <section class="section attribution-section">
    <div class="container">
      <div class="attribution-inner">
        <span class="eyebrow">Credit</span>
        <h3 class="attribution-title">Made possible by the Caring Masculinities Fund</h3>
        <p class="attribution-body">
          A fund led by Gary Barker, CEO of Equimundo: Center for Masculinities
          and Social Justice, supporting organizations worldwide that engage
          men and boys to advance gender equality. Equimundo also provided
          visibility and strategic guidance throughout development.
        </p>
      </div>
    </div>
  </section>

  <!-- Next Step -->
  <section class="section-sm film-cta-bar">
    <div class="container">
      <div class="film-cta-inner">
        <div>
          <span class="eyebrow">Next Step</span>
          <h3 class="film-cta-title">See where it started.</h3>
          <p>Release the Beast introduces the world before the game takes kids deeper into it.</p>
        </div>
        <a href="/release-the-beast" class="btn btn-outline btn-sm">Watch the Film</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  h1, h2, h3, h4 {
    color: var(--accent);
  }

  .game-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 8rem 5rem;
    position: relative;
    overflow: hidden;
  }

  .game-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/RageFighters_NoText.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .game-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(8, 3, 22, 0.55), rgba(28, 8, 50, 0.30));
  }

  /* Shared background for all sections */
  .section,
  .section-sm {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
  }

  .game-hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .hero-eyebrow .eyebrow { margin-bottom: 0; }

  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25em 0.75em;
    background: rgba(124, 92, 191, 0.2);
    border: 1px solid rgba(124, 92, 191, 0.4);
    border-radius: 100px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4a8ff;
  }

  .live-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c4a8ff;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .display {
    font-size: clamp(4rem, 12vw, 10rem);
    margin-bottom: 1.5rem;
  }

  .purple-text { color: var(--accent); }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 500;
    color: var(--fg-2);
    line-height: 1.5;
    margin-bottom: 2.5rem;
  }

  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .production-credit-mobile { display: none; }

  .production-credit {
    position: absolute;
    bottom: 5rem;
    right: var(--gutter);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
    z-index: 1;
  }

  /* About */
  .game-about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .game-about > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .game-about .eyebrow { margin-bottom: 0.5rem; }

  .game-preview {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .game-video {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: var(--radius-xl);
    display: block;
    object-fit: cover;
  }

  .game-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .spec {
    background: var(--bg-2);
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-label {
    font-size: var(--text-xs);
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .spec > span:last-child {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
  }

  /* Zones */
  .zones-section {
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    position: relative;
    background-image: url('/images/RageFighters_Entrance.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .zones-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 3, 22, 0.55);
  }

  .zones-section .container {
    position: relative;
    z-index: 1;
  }

  .zones-section .eyebrow { margin-bottom: 1rem; }
  .zones-section .subheadline { margin-bottom: 3rem; }

  .zones-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .zone-card {
    padding: 2rem 1.5rem;
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    border-top: 2px solid var(--zone-color, var(--accent));
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: var(--transition);
  }

  .zone-card:hover {
    background: var(--bg-4);
    transform: translateY(-2px);
  }

  .zone-symbol { font-size: 2rem; }

  .zone-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--zone-color, var(--accent));
  }

  .zone-desc {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.6;
  }

  /* Skills */
  .skills-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .skills-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 7rem;
  }

  .skills-list {
    display: flex;
    flex-direction: column;
  }

  .skill-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .skill-step:first-child { padding-top: 0; }
  .skill-step:last-child { border-bottom: none; padding-bottom: 0; }

  .skill-num {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--accent);
    min-width: 32px;
    padding-top: 0.2rem;
  }

  .skill-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
  }

  .skill-mechanic {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .skill-desc {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.6;
  }

  /* Notebook */
  .notebook-section {
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .notebook-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/notebook/RageStormEnemies.png') center 75% / cover no-repeat;
  }

  .notebook-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(8,3,22,0.4) 0%, rgba(8,3,22,0.5) 50%, rgba(8,3,22,1) 100%);
  }

  .notebook-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .notebook-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Attribution */
  .attribution-section {
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .attribution-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .attribution-label {
    font-size: var(--text-base);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .attribution-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .attribution-body {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.75;
  }

  /* Film CTA */
  .film-cta-bar { border-top: 1px solid var(--border); }

  .film-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .film-cta-inner > div {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .film-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .film-cta-inner p {
    font-size: var(--text-sm);
    color: var(--fg-2);
    max-width: 380px;
  }

  @media (max-width: 768px) {
    .game-about, .skills-inner, .notebook-inner { grid-template-columns: 1fr; gap: 3rem; }
    .skills-text { position: static; }
    .zones-grid { grid-template-columns: 1fr; }
    .film-cta-inner { flex-direction: column; align-items: flex-start; }

    .production-credit-mobile {
      display: block;
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.60);
      margin-top: 1rem;
    }

    /* Hero mobile fixes */
    .game-hero-bg {
      background-position: left center;
    }
    .game-hero-bg::after {
      background: linear-gradient(
        to bottom,
        rgba(8, 3, 22, 0.55) 0%,
        rgba(8, 3, 22, 0.78) 50%,
        rgba(8, 3, 22, 0.92) 100%
      );
    }
    .production-credit {
      display: none;
    }
    .hero-tagline {
      color: rgba(255, 255, 255, 0.90);
    }
  }
</style>
