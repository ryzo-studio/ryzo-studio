---
import Layout from '../layouts/Layout.astro';
import SubscribeForm from '../components/SubscribeForm';
import { fetchSanity, queries } from '../lib/sanity';

const updates = [
  {
    tag: 'New \u00b7 Video',
    heading: 'Rage Fighters: Update Video',
    body: "A fun tour of the newest features in our Roblox game \u2014 and how they're landing with boys at our in-person events.",
    cta: 'Watch on YouTube \u2192',
    href: 'https://youtu.be/HXX0y1JSyqs',
    mediaType: 'video' as const,
    embedUrl: 'https://www.youtube.com/embed/HXX0y1JSyqs',
  },
  {
    tag: 'New \u00b7 Report',
    heading: "Our 'First Franchise' Impact Report",
    body: "The full snapshot of our first franchise for boys \u2014 Release the Beast, Rage Fighters, and the Un-Tilted live tour. What happened, what we learned, and where we're heading next.",
    cta: 'Read the Report \u2192',
    href: '/docs/Ryzo_FirstFranchiseImpactReport.pdf',
    mediaType: 'cover' as const,
    cover: {
      kicker: 'First Franchise Impact Report',
      title: 'What boys do when you draw them out.',
      stats: [
        { value: '1.47M', label: 'boys reached on Roblox' },
        { value: '16,362', label: 'unique players' },
        { value: '16', label: 'live sessions, 5 states + DC' },
      ],
    },
  },
];

const events = await fetchSanity<any[]>(queries.upcomingEvents) ?? [];
---

<Layout
  title="Ryzo Studios"
  description="Ryzo Studios creates films, games, and live experiences about the questions that shape who young people become — built at the intersection of world-class storytelling and world-class research."
>

  <!-- Studio Hero -->
  <section class="studio-hero">
    <div class="hero-bg">
      <img
        src="/images/RTB_OriginStoryToy.jpg"
        alt=""
        class="hero-img"
        aria-hidden="true"
      />
    </div>
    <div class="container hero-content">
      <div class="hero-left">
        <h1 class="hero-headline display">
          Stories that<br />
          move kids<br />
          <em class="accent-text">and move kids<br />to act.</em>
        </h1>
        <p class="hero-body">
          We make films, games, and live events for kids 10 and up about
          the things that sometimes feel too big to handle. Then we show
          them what to do with it. Our first franchise is about boys and anger.
        </p>
        <div class="hero-buttons">
          <a href="/release-the-beast" class="btn btn-primary btn-lg">Watch the Film</a>
          <a href="/rage-fighters" class="btn btn-outline btn-lg">Play the Game</a>
        </div>
      </div>
      <p class="hero-cred">
        Founded by Pixar veterans.<br />Built alongside clinicians, researchers, and&nbsp;kids.
      </p>
    </div>
  </section>


  <!-- Approach -->
  <section class="section approach-section">
    <div class="container">
      <div class="approach-header">
        <span class="eyebrow">Approach</span>
        <h2 class="subheadline">One story. Three ways in.</h2>
        <p class="body-lg">Kids are watching YouTube in the back of a car. They're playing Roblox at midnight. They're making fan art in the margin of their notebook. So we build franchises — one story world with a door in each of those places.</p>
        <p class="body-lg approach-handoff">Each format does a different job.</p>
      </div>

      <div class="approach-doors">

        <div class="approach-door">
          <div class="door-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
          <div class="door-text">
            <h3 class="door-title">Animation makes you feel it.</h3>
            <p class="door-desc">A short, a series, or a feature. Our animated stories make you feel something real.</p>
            <p class="door-example"><strong>Release the Beast</strong> — Aaron is fourteen, designing a game, and his anger keeps escaping as characters he can't control. They show up in his bedroom and start giving him advice. Terrible advice. Twelve minutes, free on YouTube.</p>
            <a href="/release-the-beast" class="door-cta">Watch it →</a>
          </div>
        </div>

        <div class="approach-door">
          <div class="door-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="12" rx="2"></rect>
              <path d="M6 12h.01M10 12h.01"></path>
              <path d="M15 10l2 2-2 2"></path>
            </svg>
          </div>
          <div class="door-text">
            <h3 class="door-title">Games let you practice it.</h3>
            <p class="door-desc">Our games are where you try the skills out.</p>
            <p class="door-example"><strong>Rage Fighters</strong> — the game Aaron supposedly built himself. The enemies are his emotions, and the power-ups are skills that still work once you put the controller down. Free on Roblox.</p>
            <a href="/rage-fighters" class="door-cta">Play it →</a>
          </div>
        </div>

        <div class="approach-door">
          <div class="door-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="door-text">
            <h3 class="door-title">At live events you make it yours.</h3>
            <p class="door-desc">Our events pull the story off the screen and into your own life.</p>
            <p class="door-example"><strong>Un-Tilted</strong> — kids watch, play, and draw what their anger looks like, then share the emotion and the skill they'd use to get through it. Sixteen sessions so far.</p>
            <a href="mailto:hello@ryzo.studio?subject=EVENT%20REQUEST" class="door-cta">Bring it to your community →</a>
          </div>
        </div>

      </div>

      <p class="approach-closer">Kids start at the door they find first, and each one makes the next land harder.</p>
    </div>
  </section>

  <!-- Proof -->
  <section class="section proof-section">
    <div class="proof-bg"></div>
    <div class="proof-overlay"></div>
    <div class="container proof-content">
      <span class="eyebrow">Proof</span>
      <h2 class="subheadline">We check our work.</h2>
      <p class="proof-body">
        Every Ryzo story is built with researchers and clinicians.
        They're in it from the first outline through the final build.
      </p>
      <p class="proof-body proof-body-accent">
        Then we measure what kids actually do.
      </p>
      <div class="proof-stats">
        <div class="proof-stat">
          <span class="proof-value">16,362</span>
          <span class="proof-label">boys played Rage Fighters</span>
        </div>
        <div class="proof-stat">
          <span class="proof-value">16</span>
          <span class="proof-label">live sessions across 5 states and DC</span>
        </div>
        <div class="proof-stat">
          <span class="proof-value">248</span>
          <span class="proof-label">hand-drawn reflections, read out loud</span>
        </div>
      </div>
      <a href="/docs/Ryzo_FirstFranchiseImpactReport.pdf" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Read the First Franchise Impact Report →</a>
    </div>
  </section>


  <!-- Upcoming Events (from Sanity, shown only if there are events) -->
  {events.length > 0 && (
    <section class="section events-section">
      <div class="container">
        <div class="events-header">
          <div>
            <span class="eyebrow">Upcoming</span>
            <h2 class="subheadline">Ryzo in the world.</h2>
          </div>
          <a href="/events" class="btn btn-outline">All Events →</a>
        </div>
        <div class="events-list">
          {events.slice(0, 3).map((event: any) => (
            <div class="event-row">
              <div class="event-date">
                <span class="event-month">{new Date(event.date).toLocaleDateString('en-US', { month: 'short' })}</span>
                <span class="event-day">{new Date(event.date).getDate()}</span>
              </div>
              <div class="event-info">
                <h3 class="event-title">{event.title}</h3>
                <span class="event-location">{event.location}</span>
              </div>
              {event.registrationLink && (
                <a href={event.registrationLink} class="btn btn-outline" target="_blank" rel="noopener">Register</a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest Updates -->
  <section class="section updates-section">
    <div class="container">
      <span class="eyebrow">Latest Updates</span>
      <h2 class="subheadline">What's new.</h2>

      <div class="updates-grid">
        {updates.map((item) => (
          <div class="update-card">
            <div class="update-media">
              {item.mediaType === 'cover' && item.cover && (
                <div class="cover-treatment">
                  <span class="cover-kicker">{item.cover.kicker}</span>
                  <h3 class="cover-title">{item.cover.title}</h3>
                  <div class="cover-stats">
                    {item.cover.stats.map((s) => (
                      <div class="cover-stat">
                        <span class="stat-value">{s.value}</span>
                        <span class="stat-label">{s.label}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {item.mediaType === 'video' && item.embedUrl && (
                <div class="video-wrap">
                  <iframe
                    src={item.embedUrl}
                    title={item.heading}
                    loading="lazy"
                    allowfullscreen
                    style="position:absolute;inset:0;width:100%;height:100%;border:0;"
                  ></iframe>
                </div>
              )}
            </div>
            <div class="update-body">
              <span class="tag tag-accent">{item.tag}</span>
              <h3 class="update-heading">{item.heading}</h3>
              <p class="update-desc">{item.body}</p>
              <a href={item.href} target="_blank" rel="noopener" class="update-cta">{item.cta}</a>
            </div>
          </div>
        ))}
      </div>

      <div class="updates-subscribe">
        <p class="subscribe-lead">Want updates like these in your inbox?</p>
        <div class="subscribe-form-wrap">
          <SubscribeForm client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Studio CTA -->
  <section class="section studio-cta">
    <div class="container">
      <div class="cta-inner">
        <h2 class="subheadline">
          Work with us.<br />
          Support us.<br />
          Bring us to your community.
        </h2>
        <div class="cta-links">
          <a href="/connect" class="btn btn-primary btn-sm">Get in Touch</a>
          <a href="/events" class="btn btn-outline btn-sm">Events & Activations</a>
          <a href="/supporters" class="btn btn-outline btn-sm">Our Supporters</a>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* ─── Hero ─────────────────────────────────────────────────────────────────── */
  .studio-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 8rem 5rem;
    position: relative;
    overflow: hidden;
    --hero-accent: #f5c842;
    --hero-accent-dim: rgba(245, 200, 66, 0.15);
    --hero-purple: #2d1a5e;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  @media (max-width: 768px) {
    .hero-img {
      object-position: 78% 30%;
    }
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(5, 2, 18, 0.75) 0%,
        rgba(5, 2, 18, 0.55) 40%,
        rgba(5, 2, 18, 0.10) 65%,
        rgba(5, 2, 18, 0.0) 100%
      ),
      linear-gradient(
        to top,
        #080316 0%,
        rgba(8, 3, 22, 0.5) 20%,
        transparent 45%
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: end;
  }

  .hero-headline {
    font-size: clamp(3.5rem, 10vw, 9rem);
    margin-bottom: 2rem;
    line-height: 0.95;
    color: #f5f0ff;
    max-width: 14ch;
  }

  .accent-text {
    color: var(--hero-accent);
    font-style: normal;
  }

  .hero-body {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: rgba(210, 200, 240, 0.75);
    line-height: 1.7;
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .hero-cred {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    white-space: nowrap;
    text-align: right;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
    align-self: end;
    margin-bottom: 0.5rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ─── Shared gradient ───────────────────────────────────────────────────────── */
  .updates-section,
  .events-section,
  .studio-cta {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
  }

  /* ─── Approach ────────────────────────────────────────────────────────────── */
  .approach-section {
    background: linear-gradient(to right, #080316 0%, #1c0832 100%);
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .approach-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .approach-doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .approach-door {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: var(--transition);
  }

  .approach-door:hover {
    border-color: rgba(255,255,255,0.15);
    transform: translateY(-2px);
  }

  .door-icon {
    color: var(--accent);
    margin-bottom: 0.5rem;
    opacity: 0.85;
  }

  .door-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .door-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--accent);
    text-transform: uppercase;
  }

  .door-desc {
    font-size: var(--text-sm);
    color: var(--fg);
    line-height: 1.65;
  }

  .door-example {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.65;
  }

  .door-example strong {
    color: var(--fg);
    font-weight: 600;
  }

  .door-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--transition);
    margin-top: 0.25rem;
  }

  .door-cta:hover {
    color: var(--accent-light);
  }

  .approach-closer {
    margin-top: 2.5rem;
    font-size: var(--text-base);
    color: var(--fg-2);
    font-style: italic;
    max-width: 540px;
  }

  /* ─── Proof ───────────────────────────────────────────────────────────────── */
  .proof-section {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .proof-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/RTB_CGStan_BedJump_wide.png');
    background-size: cover;
    background-position: right top;
  }

  .proof-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8, 3, 22, 0.72) 0%, rgba(8, 3, 22, 0.45) 60%, rgba(8, 3, 22, 0.20) 100%),
      linear-gradient(to bottom, rgba(8, 3, 22, 0.05) 0%, rgba(8, 3, 22, 0.50) 100%);
  }

  .proof-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .proof-body {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    max-width: 540px;
  }

  .proof-body-accent {
    color: var(--fg);
    font-weight: 600;
    font-style: italic;
  }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 1rem;
  }

  .proof-stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .proof-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }

  .proof-label {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
  }

  .proof-content .btn {
    align-self: flex-start;
  }


  /* ─── Latest Updates ──────────────────────────────────────────────────────── */
  .updates-section {
    border-top: 1px solid rgba(255,255,255,0.07);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .updates-section .eyebrow { margin-bottom: 1rem; }
  .updates-section .subheadline { margin-bottom: 2.5rem; }

  .updates-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
  }

  .update-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .update-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .update-media {
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
  }

  .cover-treatment {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, rgba(28,8,50,0.75) 0%, rgba(14,14,16,0.65) 60%, rgba(245,200,66,0.08) 100%),
      url('/images/FranchiseReportCover.png') center / cover no-repeat;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .cover-kicker {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cover-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--fg);
  }

  .cover-stats {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .cover-stat {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--fg-3);
    line-height: 1.3;
    max-width: 10ch;
  }

  .video-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    filter: brightness(0.7);
  }

  .update-body {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .update-heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .update-desc {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.7;
    flex: 1;
  }

  .update-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--transition);
    align-self: flex-start;
  }

  .update-cta:hover {
    color: var(--accent-light);
  }

  .updates-subscribe {
    margin-top: var(--s-12);
    border-top: 1px solid var(--border);
    padding-top: var(--s-8);
  }

  .subscribe-lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--s-6);
  }

  .subscribe-form-wrap {
    max-width: 640px;
  }

  /* ─── Events ──────────────────────────────────────────────────────────────── */
  .events-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
  }

  .events-header .eyebrow {
    margin-bottom: 0.5rem;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .event-row {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 44px;
    text-align: center;
  }

  .event-month {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .event-day {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 900;
    line-height: 1;
  }

  .event-info { flex: 1; }

  .event-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .event-location {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  /* ─── Studio CTA ──────────────────────────────────────────────────────────── */
  .studio-cta {
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .cta-links {
    display: flex;
